{
  "expo": {
    "name": "BPF Programming",
    "slug": "bpf-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bpfcoaching.programming",
      "buildNumber": "9",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take progress photos.",
        "NSPhotoLibraryUsageDescription": "Used to select and save progress photos.",
        "NSPhotoLibraryAddUsageDescription": "Used to save your progress card to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bpfcoaching.programming",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to select and save progress photos.",
          "cameraPermission": "Used to take progress photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#534AB7",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f53b285c-07ef-4768-a133-6426e0d60066"
      }
    },
    "owner": "brandonsprogress"
  }
}
