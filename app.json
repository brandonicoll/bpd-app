{
  "expo": {
    "name": "BPF Programming",
    "slug": "bpf-programming",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F7F4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bpfcoaching.programming",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for sharing your progress card.",
        "NSPhotoLibraryUsageDescription": "Used to save your progress card to your photo library.",
        "NSPhotoLibraryAddUsageDescription": "Used to save your progress card to your photo library."
      }
    },
    "android": {
      "package": "com.bpfcoaching.programming",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#534AB7"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#534AB7",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f53b285c-07ef-4768-a133-6426e0d60066"
      }
    },
    "owner": "brandonsprogress"
  }
}
